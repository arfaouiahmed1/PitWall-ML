# --- Core & Storage Secrets ---
# In production, set strong unique credentials and NEVER commit secrets to git.
# For local development, copy this file to .env or use .env.development.
POSTGRES_USER=pitwall
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=pitwall
DATABASE_URL=postgresql://pitwall:${POSTGRES_PASSWORD}@localhost:5432/pitwall
REDIS_URL=redis://localhost:6379/0
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_VERSION=2.13.0

# --- API & Security Configuration ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
PITWALL_ENV=development
PITWALL_LIVE_API_KEY=your_secret_live_api_key_here
PITWALL_ALLOWED_ORIGINS=http://localhost:3000
PITWALL_OPENF1_CACHE_TTL_SECONDS=4
PITWALL_EXPOSE_METRICS=true
PITWALL_EXPOSE_DOCS=true

# --- OpenF1 (only needed for Live Mode, paid sponsor feature) ---
OPENF1_API_KEY=
OPENF1_MQTT_HOST=mqtt.openf1.org

# --- F1TV (only needed for FastF1 live timing, requires subscription) ---
F1TV_EMAIL=
F1TV_PASSWORD=

# --- Monitoring ---
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_strong_grafana_password_here

# --- Deployment ---
# Vercel / GitHub Pages (frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
