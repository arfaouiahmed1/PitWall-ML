# --- Core ---
DATABASE_URL=postgresql://pitwall:pitwall@localhost:5432/pitwall
REDIS_URL=redis://localhost:6379/0
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_VERSION=2.13.0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- OpenF1 (only needed for Live Mode, paid sponsor feature) ---
OPENF1_API_KEY=
OPENF1_MQTT_HOST=mqtt.openf1.org

# --- F1TV (only needed for FastF1 live timing, requires subscription) ---
F1TV_EMAIL=
F1TV_PASSWORD=

# --- Monitoring ---
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_ADMIN_PASSWORD=pitwall

# --- Deployment ---
# Vercel (frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
