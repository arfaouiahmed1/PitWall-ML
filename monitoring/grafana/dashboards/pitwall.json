{
  "id": null,
  "uid": "pitwall-v3",
  "title": "PitWall ML — Race Intelligence (V3)",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Pace MAE (champion)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "pace_mae_seconds", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 0.52 }] } }, "overrides": [] }
    },
    {
      "type": "gauge",
      "title": "80% Interval Coverage",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "pace_interval_coverage", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 0.75 }, { "color": "green", "value": 0.78 }] } } }
    },
    {
      "type": "stat",
      "title": "Inference p95",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, rate(inference_duration_seconds_bucket[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 0.1 }] } } }
    },
    {
      "type": "stat",
      "title": "Drifting Features Ratio",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "drifting_features_ratio", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.2 }] } } }
    },
    {
      "type": "timeseries",
      "title": "Event Processing Lag",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "event_processing_lag_seconds", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests /s",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "rate(http_requests_total[5m])", "refId": "A", "legendFormat": "{{endpoint}} {{status}}" }]
    },
    {
      "type": "timeseries",
      "title": "Replay Events Processed",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 10 },
      "targets": [{ "expr": "rate(replay_events_processed_total[5m])", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "WS Clients",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 10 },
      "targets": [{ "expr": "websocket_clients", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Feature Freshness",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 10 },
      "targets": [{ "expr": "feature_freshness_seconds", "refId": "A" }]
    }
  ]
}
